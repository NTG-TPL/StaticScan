{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "GCC: Build Debug app",
            "type": "shell",
            "command": [
                "mkdir ${workspaceFolder}/build ; ",
                "cd ${workspaceFolder}/build &&",
                "cmake .. -DCMAKE_BUILD_TYPE=Debug && cmake --build ."
            ],
            "presentation": {
                "clear": true
            },
            "hide": false,
            "group": {
                "kind": "build"
            }
        },
        {
            "label": "GCC: Build Release app",
            "type": "shell",
            "command": [
                "mkdir ${workspaceFolder}/build ; ",
                "cd ${workspaceFolder}/build &&",
                "cmake .. -DCMAKE_BUILD_TYPE=Release && cmake --build ."
            ],
            "presentation": {
                "clear": true
            },
            "hide": false,
            "group": {
                "kind": "build"
            }
        },
        {
            "label": "Lint: clang-format + clang-tidy",
            "type": "shell",
            "command": "clang-format --dry-run --Werror ${workspaceFolder}/include/stdx/*.hpp ${workspaceFolder}/tests/*.cpp ${workspaceFolder}/tests/compile_fail/*.cpp && clang-tidy-20 -p ${workspaceFolder}/build --quiet --header-filter='^${workspaceFolder}/(include|tests)/' ${workspaceFolder}/tests/*.cpp",
            "presentation": {
                "clear": true
            },
            "problemMatcher": "$gcc"
        }
    ]
}
